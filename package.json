{
  "name": "blue-water-logistics",
  "version": "1.0.0",
  "private": true,
  "description": "Blue Water Logistics Limited - Enterprise Platform (Frontend & Backend)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
