# ==========================================
# Blue Water Logistics - Environment Variables
# ==========================================

# (Optional) MongoDB Connection URI - e.g. MongoDB Atlas cluster
# If not provided, BWL runs gracefully using the built-in in-memory dataset
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bwl_production?retryWrites=true&w=majority

# (Optional) Secret key used to sign Admin JWT tokens
JWT_SECRET=your-secure-random-jwt-secret-key-change-in-production

# (Optional) External Express Backend URL
# Only set this if you are hosting the separate backend/ server on Render/Railway/VPS.
# If omitted, Next.js handles all /api/* routes internally via serverless functions.
# BACKEND_URL=https://your-backend-api.onrender.com
